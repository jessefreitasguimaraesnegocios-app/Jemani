# URL pública do site (manifesto + APK de atualização do app Android)
# VITE_APP_UPDATE_URL=https://jemani.vercel.app

# Modo DEMO (UI local com regras de negócio completas)
VITE_DEMO_MODE=true

# Simulação de pagamento — SOMENTE desenvolvimento (APK zera isso)
VITE_ALLOW_DEV_PAYMENT=true

# Stripe Checkout / Connect
# Padrão de teste: Edge Functions no Supabase (sempre ligadas).
# NÃO defina VITE_STRIPE_API_URL no dia a dia.
VITE_STRIPE_ENABLED=true
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Opcional — só para depurar com npm run stripe:local:
# VITE_STRIPE_API_URL=http://127.0.0.1:8787
#
# Produção real: trocar pk_test_ → pk_live_ e secrets sk_live_ no Supabase.
# Ver docs/STRIPE_PRODUCAO.md

# Timezone da regra de 4 horas
VITE_TIMEZONE=America/Los_Angeles

# Supabase (necessário para Edge Functions do Stripe)
VITE_SUPABASE_URL=https://qdiocaeoevxhdsrtcahn.supabase.co
VITE_SUPABASE_ANON_KEY=

# Mapbox (token público, começa com pk.)
VITE_MAPS_PROVIDER=mapbox
VITE_MAPBOX_ACCESS_TOKEN=

# Secrets só no Supabase (NUNCA no Vite):
# STRIPE_SECRET_KEY=sk_test_...   → em produção: sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# APP_URL=https://jemani.vercel.app
