# Modo DEMO (UI local com regras de negócio completas)
VITE_DEMO_MODE=true

# Simulação de pagamento — SOMENTE desenvolvimento
VITE_ALLOW_DEV_PAYMENT=true

# Stripe Checkout / Connect (teste)
VITE_STRIPE_ENABLED=false
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Servidor local: npm run stripe:local  (secret em supabase/functions/.env)
# VITE_STRIPE_API_URL=http://127.0.0.1:8787

# Timezone da regra de 4 horas
VITE_TIMEZONE=America/Los_Angeles

# Supabase (necessário também para chamar Edge Functions do Stripe em DEMO)
VITE_SUPABASE_URL=https://qdiocaeoevxhdsrtcahn.supabase.co
VITE_SUPABASE_ANON_KEY=

# Mapbox (Default public token, começa com pk.)
VITE_MAPS_PROVIDER=mapbox
VITE_MAPBOX_ACCESS_TOKEN=

# Secrets só no Supabase / servidor (NUNCA no Vite):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# APP_URL=http://localhost:5173
